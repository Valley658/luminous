# =========================================================
# secrets - never commit
# =========================================================
.env
.env.*
!.env.example
# SECRET_KEY를 .env에 안 채우면 여기(프로젝트 루트)에 자동 생성됨
.secret_key

# =========================================================
# python
# =========================================================
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# 실제 런타임 DB 파일(진짜 사용자 데이터 들어있음) - 절대 커밋 금지
go-server/db/

# 로컬 sqlite 폴백 DB (DB_BACKEND 미지정 시 기본값). .env.dev로 Air 개발 서버를 띄우면
# 여기(프로젝트 루트/db/)에 생성됨 - 운영 MySQL과는 무관한 로컬 전용 데이터.
/db/

# =========================================================
# runtime logs (regenerated by the services, not source)
# =========================================================
logs/
**/logs/
*.log

# DB 백업 (backup_db.ps1이 로컬에 만드는 덤프, git에 올릴 필요 없음)
backups/

# =========================================================
# frontend build tooling
# =========================================================
# [2026-10-02] 원본 JS는 frontend/js/ 에만 두고 git에 올리지 않는다.
# static/js/*.js 는 tools/build-obfuscated-js.js 가 만든 난독화 결과물이고,
# 사이트도 GitHub도 이 난독화 파일만 공개한다. (scripts\JS빌드.bat)
frontend/
# ...and their cache-busted-by-filename variants, if anything ever writes one
# again (found 2026-09-08: static/js/m.<hash>.js / watch.<hash>.js had leaked
# into git as plain source - versioned_static() actually only appends a ?v=
# query string in both Python and Go, so these were dead orphaned copies with
# no code path producing or referencing them - deleted, see git log).
static/js/script.*.js
static/js/watch.*.js
static/js/m.*.js
static/js/node_modules/
_xfer/

# same hash-suffixed-cache-busting-filename leak, found in static/css (2026-09-08):
# static/css/m.css, watch.css, style.css ARE meant to be committed (CSS isn't
# obfuscated), but static/css/m.<hash>.css / watch.<hash>.css were byte-identical
# dead duplicates - deleted, and ignored here so they can't sneak back in.
static/css/m.*.css
static/css/watch.*.css
static/css/style.*.css
node_modules/

# =========================================================
# vendored / large binaries - not source, see README.md for how to obtain
# =========================================================
# (java-image-service was removed - replaced by c-image-service. Its leftover
# local-only folders, if you still have them on disk, are jdk17/out/logs.)
services/c-image-service/logs/

# 2026-09-08: 실행파일/런처가 go-server/bin/, c-image-service/bin/으로 정리되면서
# 아래 경로들도 다 bin/ 밑으로 옮김 (탐색기에 .exe/.bat가 그대로 노출되는 게 지저분해서).

# build-time backup/swap artifacts for the Go binary (not source)
go-server/bin/pastellive-server.new.exe
go-server/bin/pastellive-server.old.exe

# same backup/swap pattern for the C image service binary
services/c-image-service/bin/pastellive-image-service.new.exe
services/c-image-service/bin/pastellive-image-service.old.exe

# same backup/swap pattern for the discord bot binary
go-server/bin/discord-bot.new.exe
go-server/bin/discord-bot.old.exe

# same backup/swap pattern for the phash-service binary
services/phash-service/bin/pastellive-phash-service.new.exe
services/phash-service/bin/pastellive-phash-service.old.exe

# 이전 빌드/실패한 빌드 백업은 전부 여기로 - 파일명 하나하나 나열할 필요 없이 폴더째 무시
go-server/bin/backup/
services/c-image-service/bin/backup/

# Rust build output (Cargo.toml/Cargo.lock/src/*.rs are the source; the
# committed binary is c-image-service/bin/pastellive-image-service.exe)
services/c-image-service/target/

# Zig build output (build.zig/src/main.zig are the source; the committed
# binary is phash-service/bin/pastellive-phash-service.exe)
services/phash-service/.zig-cache/
services/phash-service/zig-out/

# stray non-Windows build of the C image service (built for local testing only;
# the production server runs a Windows build produced via c-image-service's own
# build steps, see its README)
services/c-image-service/bin/pastellive-image-service

# stray non-Windows builds of the Go discord bot / watchdog / lumi-admin
# ("go build ./..." without -o writes these to go-server/ named after the
# package dir - not source, and the committed *.exe builds are the ones
# production actually uses)
go-server/discordbot
go-server/watchdog
go-server/lumi-admin

# 루미 데이터 편집 페이지(cmd/lumi-admin, 루미데이터_편집.bat)가 저장하는
# 실제 멤버 프로필 내용 - 리도님이 직접 쓴 개인 데이터라 배포마다 다르고
# 계속 바뀌니 소스가 아님. 파일이 없으면 lumiprofiles.Load가 그냥 빈 걸로
# 취급하니 새로 배포해도 문제 없음.
go-server/lumi_data/

# machine-specific launcher scripts generated by install_all.bat (bakes in
# absolute paths resolved on that machine - not portable, not source)
services/c-image-service/bin/_run_production.bat
services/c-image-service/bin/_run_test.bat
services/nsfw-service/bin/_run_production.bat
services/phash-service/bin/_run_production.bat
services/member-id-service/bin/_run_production.bat
go-server/bin/_run_discordbot_loop.bat
go-server/bin/_run_server_watchdog.bat

# 사진인식_설치.bat가 pip로 만드는 가상환경(소스 아님) + 최초 실행 때 받는
# CLIP 인식 모델(~90MB)과 멤버 참고 사진 캐시(소스 아님, 용량도 큼)
services/member-id-service/runtime/
services/member-id-service/models/
services/member-id-service/reference_cache/
services/member-id-service/logs/

# personal git helper (auto add-commit-push) - not source, and must stay
# gitignored so `git add -A` inside it never stages itself
deploy/windows/_git_commit_push.bat

# =========================================================
# generated/cache content (regenerated at runtime, not source)
# =========================================================
static/drive_thumbs/
static/drive_previews/
static/highlights/

# user-uploaded content (back up separately, not via git)
static/uploads/

# =========================================================
# media files - block NEW ones from being added, going forward
# (2026-09-10: repo already has a lot of committed audio/images from before this
# rule existed - those stay tracked as-is, since gitignore only affects files
# that aren't tracked yet. To add a new media file on purpose anyway, force it:
# `git add -f path/to/file.png`)
# =========================================================
*.mp3
*.mp4
*.mov
*.avi
*.webm
*.wav
*.ogg
*.png
*.jpg
*.jpeg
*.webp
*.gif

# =========================================================
# local dev tooling (Air live-reload) - not source
# =========================================================
go-server/tmp/

# =========================================================
# runtime disk cache (regenerated automatically, not source)
# =========================================================
/data/
data/video_pool_cache.json*

# =========================================================
# OS / editor
# =========================================================
.DS_Store
Thumbs.db
.vscode/

# 루미 목소리 음성 파일 (서버가 VoiceStudio로 자동 생성)
static/lumi_voice/

# 작업 중 백업 (2026-10-01)
_backup_*/
*.bak_fanartcache
*.bak_lumivoice
*.bak_babowiki_*
# 크레딧 페이지에 출처가 적힌 PNGimg 그림(CC BY-NC 4.0)은 저장소에도 포함
!static/images/pngimg/*.webp
# 멤버 공식 노래·사진(배경음용) - 저작권 있는 원본이라 공개 저장소에는 올리지 않음
static/music/
*.template.bak_*
scripts/rdp_backup_*.reg
