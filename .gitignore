# =========================================================
# secrets - never commit
# =========================================================
.env
.env.*
!.env.example
# SECRET_KEY를 .env에 안 채우면 여기(프로젝트 루트)에 자동 생성됨
.secret_key

# =========================================================
# python
# =========================================================
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# 실제 런타임 DB 파일(진짜 사용자 데이터 들어있음) - 절대 커밋 금지
go-server/db/

# 로컬 sqlite 폴백 DB (DB_BACKEND 미지정 시 기본값). .env.dev로 Air 개발 서버를 띄우면
# 여기(프로젝트 루트/db/)에 생성됨 - 운영 MySQL과는 무관한 로컬 전용 데이터.
/db/

# =========================================================
# runtime logs (regenerated by the services, not source)
# =========================================================
logs/
**/logs/
*.log

# DB 백업 (backup_db.ps1이 로컬에 만드는 덤프, git에 올릴 필요 없음)
backups/

# =========================================================
# frontend build tooling
# =========================================================
# [2026-10-02] 원본 JS는 frontend/js/ 에만 두고 git에 올리지 않는다.
# static/js/*.js 는 tools/build-js.js 가 만든 압축(minify) 결과물이고,
# 사이트도 GitHub도 이 압축 파일만 공개한다. (scripts/JS빌드.sh)
frontend/
# ...and their cache-busted-by-filename variants, if anything ever writes one
# again (found 2026-09-08: static/js/m.<hash>.js / watch.<hash>.js had leaked
# into git as plain source - versioned_static() actually only appends a ?v=
# query string in both Python and Go, so these were dead orphaned copies with
# no code path producing or referencing them - deleted, see git log).
static/js/script.*.js
static/js/watch.*.js
static/js/m.*.js
static/js/node_modules/
_xfer/

# same hash-suffixed-cache-busting-filename leak, found in static/css (2026-09-08):
# static/css/m.css, watch.css, style.css ARE meant to be committed (CSS isn't
# obfuscated), but static/css/m.<hash>.css / watch.<hash>.css were byte-identical
# dead duplicates - deleted, and ignored here so they can't sneak back in.
static/css/m.*.css
static/css/watch.*.css
static/css/style.*.css
node_modules/

# =========================================================
# vendored / large binaries - not source, see README.md for how to obtain
# =========================================================
# [2026-10-02] 우분투(리눅스)로 이전. 실행 파일은 .exe 없이 bin/ 아래 리눅스 바이너리이고
# systemd 서비스(deploy/linux/systemd)가 띄운다. Windows 버전은 2026-10-02 이전 git 기록에 있음.
services/c-image-service/logs/
services/nsfw-service/logs/
services/phash-service/logs/
go-server/logs/

# 새 빌드 교체용 임시 파일 (scripts/빌드배포.sh, watch_and_apply.sh 가 *.new → 실행 파일, 이전 것은 *.old)
go-server/bin/*.new
go-server/bin/*.old
services/c-image-service/bin/*.new
services/c-image-service/bin/*.old
services/phash-service/bin/*.new
services/phash-service/bin/*.old
go-server/bin/backup/
services/c-image-service/bin/backup/

# Rust 빌드 결과 (소스: Cargo.toml/Cargo.lock/src/*.rs, 올리는 실행 파일: bin/pastellive-image-service)
services/c-image-service/target/

# Zig 빌드 결과 (소스: build.zig/src/main.zig, 올리는 실행 파일: bin/pastellive-phash-service)
services/phash-service/.zig-cache/
services/phash-service/zig-out/
tools/.zig-venv/

# "go build ./..." 를 -o 없이 돌리면 go-server/ 에 생기는 실행 파일 (소스 아님)
go-server/discordbot
go-server/watchdog
go-server/lumi-admin
go-server/server

# 루미 데이터 편집 페이지(cmd/lumi-admin)가 저장하는 실제 멤버 프로필 내용 - 개인 데이터라 소스가 아님.
go-server/lumi_data/

# nsfw-service 파이썬 가상환경 (install_all.sh 8 이 requirements.txt 로 만든다, 소스 아님)
services/nsfw-service/runtime/
**/__pycache__/

# member-id-service 가상환경/모델/캐시 (소스 아님, 용량 큼)
services/member-id-service/runtime/
services/member-id-service/models/
services/member-id-service/reference_cache/
services/member-id-service/logs/

# 개인용 git 도우미 (자동 add-commit-push) - git add -A 에 자기 자신이 섞이지 않게 무시
deploy/linux/_git_commit_push.sh

# =========================================================
# generated/cache content (regenerated at runtime, not source)
# =========================================================
static/drive_thumbs/
static/drive_previews/
static/highlights/

# user-uploaded content (back up separately, not via git)
static/uploads/

# =========================================================
# media files - block NEW ones from being added, going forward
# (2026-09-10: repo already has a lot of committed audio/images from before this
# rule existed - those stay tracked as-is, since gitignore only affects files
# that aren't tracked yet. To add a new media file on purpose anyway, force it:
# `git add -f path/to/file.png`)
# =========================================================
*.mp3
*.mp4
*.mov
*.avi
*.webm
*.wav
*.ogg
*.png
*.jpg
*.jpeg
*.webp
*.gif

# =========================================================
# local dev tooling (Air live-reload) - not source
# =========================================================
go-server/tmp/

# =========================================================
# runtime disk cache (regenerated automatically, not source)
# =========================================================
/data/
data/video_pool_cache.json*

# =========================================================
# OS / editor
# =========================================================
.DS_Store
Thumbs.db
.vscode/

# 루미 목소리 음성 파일 (서버가 VoiceStudio로 자동 생성)
static/lumi_voice/

# 작업 중 백업 (2026-10-01)
_backup_*/
*.bak_fanartcache
*.bak_lumivoice
*.bak_babowiki_*
# 크레딧 페이지에 출처가 적힌 PNGimg 그림(CC BY-NC 4.0)은 저장소에도 포함
!static/images/pngimg/*.webp
# 멤버 공식 노래·사진(배경음용) - 저작권 있는 원본이라 공개 저장소에는 올리지 않음
static/music/
*.template.bak_*
scripts/rdp_backup_*.reg

# =========================================================
# DB 데이터/덤프 - 어디에 있든 절대 커밋 금지 (2026-10-02)
# 운영 DB(MySQL 8.0 pastellive_db)의 내용이 덤프나 로컬 사본으로
# 저장소에 섞여 들어가지 않게 확장자 기준으로 전부 막는다.
# =========================================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.sql.zip
*.dump
*.ibd
*.frm

# =========================================================
# 비밀키/인증서 - 절대 커밋 금지 (2026-10-02)
# =========================================================
*.pem
*.key
*.pfx
*.p12
*.crt
*.csr
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials*.json
client_secret*.json
service-account*.json
token.json
*.secret
.htpasswd

# =========================================================
# Go 빌드/테스트 부산물
# =========================================================
*.test
*.prof
*.pprof
coverage.out
coverage.html
cover.out
go.work
go.work.sum

# =========================================================
# Node / Python 부산물
# =========================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.eslintcache
*.tsbuildinfo
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/

# =========================================================
# 임시/백업/편집기 파일
# =========================================================
*.tmp
*.temp
*.bak
*.bak_*
*.orig
*.rej
*.swp
*.swo
*~
.idea/
*.code-workspace
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk

# =========================================================
# 압축/덤프/크래시 파일
# =========================================================
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.dmp
*.stackdump


# 리눅스 전용 프로젝트 - Windows 실행 파일은 올리지 않음
*.exe
*.bat
*.ps1
