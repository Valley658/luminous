worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       C:/nginx/conf/mime.types;
    default_type  application/octet-stream;

    server_names_hash_bucket_size 64;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;

    proxy_connect_timeout 1s;

    # [2026-09-25 보안 점검] Cloudflare Origin CA 인증서로 Cloudflare<->Origin
    # 구간(SSL/TLS 모드: 전체/Full)을 HTTPS로 암호화. TLS 1.0/1.1은 아예
    # 제외하고, TLS 1.2는 AEAD(GCM/ChaCha20) 암호만 허용해 CBC 계열
    # (LUCKY13 등 취약점 대상)을 제거했다. TLS 1.3은 프로토콜 자체가
    # AEAD 암호만 쓰므로 별도 지정 불필요.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_certificate     C:/nginx/certs/pastellive_origin.pem;
    ssl_certificate_key C:/nginx/certs/pastellive_origin.key;

    log_format timing '$remote_addr - [$time_local] "$request" $status '
                       'rt=$request_time uct=$upstream_connect_time urt=$upstream_response_time '
                       'upstream=$upstream_addr';

    open_file_cache max=2000 inactive=30s;
    open_file_cache_valid 60s;
    open_file_cache_min_uses 2;
    open_file_cache_errors off;

    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml;

    proxy_cache_path C:/nginx/proxy_cache levels=1:2 keys_zone=api_cache:20m max_size=200m inactive=10m use_temp_path=off;

    proxy_cache_key "$scheme$host$request_uri";

    upstream pastellive_backend {
        server 127.0.0.1:8081 max_fails=2 fail_timeout=15s;
        keepalive 64;
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    map "$http_accept:$uri" $avif_candidate {
        default "";
        "~*^.*image/avif.*:(?<pfx>/static/.+)\.webp$" "${pfx}.avif";
    }

    # [2026-09-25 보안 점검] server_name이 일치하는 블록이 없는 요청을 위한
    # 명시적 기본 서버. 이게 없으면 nginx는 "이 conf 파일에서 가장 먼저 나오는
    # server 블록"(바로 아래 pastellive.co.kr 블록)을 기본값으로 써서, 아무
    # Host 헤더로나(엉뚱한 도메인, IP 직접 접근 등) 실제 서비스가 그대로
    # 응답해버린다. 이 블록을 먼저 두고 default_server로 지정해서 그런
    # 요청은 즉시 연결을 끊게 한다.
    #
    # 주의: 이것만으로는 "Cloudflare를 거치지 않고 Origin IP:80/443에 직접
    # Host: pastellive.co.kr 로 접근하는" 우회를 막지 못한다(Host를 정확히
    # 맞춰서 보내면 그대로 아래 실제 서버 블록에 도달함). 그건 이 conf 파일
    # 로는 원천적으로 막을 수 없고, OS 방화벽에서 80/443을 Cloudflare IP
    # 대역에서 오는 연결만 허용하도록 제한해야 한다(scripts\setup_cloudflare_firewall.ps1 참고).
    server {
        listen       80 default_server;
        listen       443 ssl default_server;
        server_name  _;
        return 444;
    }

    server {
        listen       80;
        listen       443 ssl;
        server_name  localhost pastellive.co.kr www.pastellive.co.kr m.pastellive.co.kr;

        # [2026-09-25 보안 점검] 기본 보안 헤더. 사이트가 쓰는 외부 리소스
        # (YouTube 임베드, cdnjs/jsdelivr 스크립트·폰트, 구글/그라바타 이미지
        # 등)를 깨뜨리지 않는 선에서 우선 넣을 수 있는 것들만 강제 적용했고,
        # CSP는 아직 강제하지 않고 Report-Only로만 켜뒀다(/api/csp-report로
        # 위반 로그가 쌓이니, 몇 주 지켜보고 문제 없으면 Content-Security-Policy로
        # 바꿔서 강제 적용하면 됨). COOP/CORP/COEP는 디스코드 로그인, 구글
        # 드라이브 미리보기 iframe, 외부 이미지 등과 충돌 가능성을 확인 못 해서
        # 이번엔 넣지 않음 - 필요하면 직접 테스트 후 추가할 것.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://www.youtube.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net data:; img-src 'self' data: blob: https://i.ytimg.com https://encrypted-tbn0.gstatic.com https://lh3.googleusercontent.com https://www.gravatar.com; media-src 'self' blob:; frame-src 'self' https://www.youtube.com https://drive.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; report-uri /api/csp-report;" always;

        access_log  C:/nginx/logs/timing.log  timing;

        root __PROJECT_DIR__;

        client_max_body_size 130M;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        if ($http_user_agent ~* (GenomeCrawler|ZmEu|sqlmap|nikto|scan|curl|wget|python-requests|libredtail-http|CensysInspect|zgrab)) {
            return 444;
        }

        if ($request_uri ~* "(wget|chmod|rm\s-rf|/bin/sh|cmd\.exe|eval\()") {
            return 444;
        }

        location ~* (/\.env|/\.git|/wp-login\.php|/wp-admin|/phpunit|/cgi-bin|/actuator|/docker-compose|/config\.json|/status\.php) {
            return 444;
        }

        location = /static/manifest.json {
            alias __STATIC_DIR__/manifest.json;
            default_type application/manifest+json;
            add_header Cache-Control "no-cache" always;
        }

        location /static/ {
            alias __STATIC_DIR__/;
            access_log off;
            add_header Cache-Control "no-cache" always;
        }

        location ~* ^/static/(.+)\.webp$ {
            add_header Vary Accept always;
            add_header Cache-Control "no-cache" always;
            access_log off;
            try_files $avif_candidate $uri =404;
        }

        location ~ ^/api/videos/(random_scroll|recommend_random|home_shorts)$ {
            proxy_pass http://pastellive_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            add_header X-Cache-Status "BYPASS-RANDOM";
        }

        location ~ ^/api/(videos/|live_status$|drive_video_title/|search$|search/trending$|kirinuki/videos$) {
            proxy_pass http://pastellive_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            proxy_cache api_cache;
            proxy_cache_valid 200 30s;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503;
            proxy_cache_bypass $cookie_session;
            proxy_no_cache $cookie_session;
            add_header X-Cache-Status $upstream_cache_status;
        }

        location ~ ^/api/drive_thumb/([a-zA-Z0-9_-]+)$ {
            root __STATIC_DIR__;
            try_files /drive_thumbs/$1.jpg @drive_thumb_proxy;
        }
        location @drive_thumb_proxy {
            internal;
            proxy_pass http://pastellive_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        location / {
            proxy_pass http://pastellive_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   C:/nginx/html;
        }
    }

    server {
        listen       80;
        listen       443 ssl;
        server_name  admin.pastellive.co.kr;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()" always;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        location /static/ {
            alias __STATIC_DIR__/;
            access_log off;
            add_header Cache-Control "no-cache" always;
        }

        location / {
            proxy_pass http://pastellive_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   C:/nginx/html;
        }
    }

    server {
        listen       80;
        listen       443 ssl;
        server_name  api.pastellive.co.kr;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()" always;

        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        location /static/ {
            alias __STATIC_DIR__/;
            access_log off;
            add_header Cache-Control "no-cache" always;
        }

        location / {
            proxy_pass http://pastellive_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   C:/nginx/html;
        }
    }

    server {
        listen       80;
        listen       443 ssl;
        server_name  restore.pastellive.co.kr;

        location / {
            proxy_pass http://127.0.0.1:25565;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }

    server {
        listen       80;
        listen       443 ssl;
        server_name  world.pastellive.co.kr;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()" always;

        client_max_body_size 130M;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        location /static/ {
            alias __STATIC_DIR__/;
            access_log off;
            add_header Cache-Control "no-cache" always;
        }

        location / {
            proxy_pass http://pastellive_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   C:/nginx/html;
        }
    }

}
