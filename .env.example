# ---- 데이터베이스 (MySQL) --------------------------------------------------
DB_BACKEND=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=pastellive_db

# 루미(AI 마스코트) 대화 기록 전용 DB - 위 DB_NAME(pastellive_db)과 같은
# MySQL 서버/계정을 쓰되 완전히 별도의 DB로 분리되어 있습니다. 처음 실행 시
# 없으면 자동으로 만들어지니 미리 만들어둘 필요는 없습니다.
LUMI_DB_NAME=lumi_db

# ---- 세션/쿠키 서명 키 -------------------------------------------------------
# 비워두면 첫 실행 시 자동으로 랜덤 생성되어 프로젝트 루트의 .secret_key 파일에
# 저장되고, 이후 재시작해도 그 값을 계속 씁니다(로그인이 풀리지 않음). 직접
# 정하고 싶으면 아무 랜덤 문자열이나 넣으면 됩니다.
SECRET_KEY=

# ---- 디스코드 OAuth 로그인 ---------------------------------------------------
# https://discord.com/developers/applications 에서 발급
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://your-domain.example/auth/discord/callback

# ---- 디스코드 봇 (운영봇) -----------------------------------------------------
DISCORD_BOT_TOKEN=
# 상태/에러 알림을 받을 채널 ID. 비워두면 알림 비활성화.
DISCORD_ALERT_CHANNEL_ID=
# 봇 관리자 전용 명령(서비스 재시작)을 쓸 수 있는 디스코드 유저 ID.
# 비워두면 아무도 못 씀(막힘). 디스코드에서 개발자 모드 켜고 본인 프로필 우클릭 -> ID 복사.
DISCORD_AUTHORIZED_USER_ID=
# 봇이 슬래시 명령을 등록할 길드(서버) ID. 비워두면 전역 명령으로 등록됨(전파가 느림, 최대 1시간).
DISCORD_GUILD_ID=

# ---- 외부 API ----------------------------------------------------------------
YOUTUBE_API_KEY=
GOOGLE_DRIVE_API_KEY=

# ---- 이미지 처리 서비스 (Rust, c-image-service, 포트 8091) --------------------
JAVA_IMAGE_SERVICE_URL=http://127.0.0.1:8091

# ---- AI 자동 모더레이션 서비스 (Python+NudeNet, nsfw-service, 포트 8095) -------
# 비워두면 모더레이션 비활성화(모든 업로드 자동 통과)
MODERATION_SERVICE_URL=http://127.0.0.1:8095
JAVA_IMAGE_SERVICE_TIMEOUT_SEC=8

# ---- 팬아트 재업로드/도용 탐지 (Zig, phash-service, 포트 8096) ----------------
# 비워두면 재업로드 탐지 비활성화(다른 업로드 기능에는 영향 없음)
PHASH_SERVICE_URL=http://127.0.0.1:8096
# 두 이미지의 perceptual hash가 몇 비트(총 64비트 중) 이하로 다르면 "유사"로
# 보고 신고 큐에 자동 등록할지. 낮을수록 완전히 똑같은 이미지만 잡아내고,
# 높을수록 살짝 편집된 이미지까지 잡아내되 오탐이 늘어납니다.
PHASH_DUPLICATE_THRESHOLD=6

# ---- 루미 마스코트 AI 대화 (로컬 LLM, Ollama) --------------------------------
# 외부 API 키 없이 같은 서버에서 돌아가는 Ollama(http://127.0.0.1:11434)를 사용.
# 설치는 로컬AI_설치.bat 참고. 비워두지 않아도 되고, 기본값을 쓰면 이 줄들은
# 아예 안 적어도 됩니다.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_TIMEOUT_SEC=90
# 루미 답변 하나당 최대 생성 토큰 수. CPU 전용 서버에서는 이 값만큼 그대로
# 추론 시간/CPU 사용량이 늘어남 - CPU가 버거우면 줄이고(예: 140), GPU를 붙여서
# Ollama가 GPU를 쓰게 되면 여유 있게 더 늘려도 됨.
OLLAMA_NUM_PREDICT=220

# 답변 전에 짧게 웹 검색(순수 HTTP, 브라우저 자동화 없음)을 해서 최신/정확한
# 정보를 참고하게 할지. 끄고 싶으면 false.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT_SEC=6

# ---- 요청 속도 제한 (Go 서버 자체 기능) --------------------------------------
# /static/ 경로는 항상 예외. 아래는 기본값입니다.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=10
RATE_LIMIT_MAX_REQUESTS=150
RATE_LIMIT_BAN_MINUTES=15

# ---- 관리자/개발자 권한 -------------------------------------------------------
# 콤마로 구분된 닉네임/이메일/IP. 비워두면 해당 검사 비활성화.
STAFF_NICKNAMES=
DEV_NICKNAMES=
DEV_EMAIL=
DEV_BYPASS_IPS=
# 팬아트/댓글 작성자 이름 옆에 뜨는 스태프 뱃지 라벨. "닉네임:라벨"을 콤마로 구분.
# 예: STAFF_ROLE_LABELS=닉네임1:개발자,닉네임2:디자인담당
# 공개 API(/api/staff-roles)로 그대로 노출되니 실명/이메일 등 민감정보는 넣지 마세요.
STAFF_ROLE_LABELS=

# ---- 사이트/관리자 도메인 -----------------------------------------------------
SITE_HOST=your-domain.example
ADMIN_HOSTNAME=admin.your-domain.example
ADMIN_NICKNAME=
# 관리자 Drive 파일 도구를 쓸 수 있는 이메일.
ADMIN_DRIVE_ALLOWED_EMAIL=
# 로컬 http://에서 개발할 때만 false로. 운영(https+nginx)에선 true 유지.
COOKIE_SECURE=true

# ---- 검색 (선택 - 설정 안 하거나 연결 안 되면 그냥 DB 검색으로 대체) ----------
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ---- 백그라운드 스케줄러 -------------------------------------------------------
SCHEDULER_ENABLED=true
INTERNAL_API_KEY=
# 선택 - 관리자 대시보드 헬스체크용. Redis 자체를 안 쓴다면 비워둬도 됩니다.
REDIS_URL=

# ---- WebSub / 웹훅 (선택) ----------------------------------------------------
WEBSUB_CALLBACK_BASE=https://your-domain.example
# 비워두면 실행할 때마다 랜덤 생성(재시작해도 상관없는 값이라 저장 안 함).
WEBSUB_SECRET=
N8N_NEW_VIDEO_WEBHOOK_URL=

# ---- 고급 설정 (보통 기본값 그대로 두면 됨) -----------------------------------
# Go 서버가 붙는 주소. nginx의 upstream 포트와 반드시 같은 값이어야 합니다.
LISTEN_ADDR=127.0.0.1:8081
